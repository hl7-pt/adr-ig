# - resource -------------------------------------------------------------------

<https://hl7.pt/fhir/ADR/Patient/pat-1> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "pat-1"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "https://hl7.pt/fhir/ADR/StructureDefinition/Doente"^^xsd:anyURI ;
       fhir:link <https://hl7.pt/fhir/ADR/StructureDefinition/Doente>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Narrativa gerada: Patient pat-1</b></p><a name=\"pat-1\"> </a><a name=\"hcpat-1\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Perfil: <a href=\"StructureDefinition-Doente.html\">Perfil para notificação de RAM - Doente</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Américo  Male, DoB: 1980-01-01</p><hr/></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:name ( [
     fhir:given ( [ fhir:v "Américo" ] )
  ] ) ; # 
  fhir:gender [ fhir:v "male"] ; # 
  fhir:birthDate [ fhir:v "1980-01-01"^^xsd:date] . # 

